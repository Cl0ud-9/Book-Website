---
import ButtonAlt from "./ButtonAlt.astro";
import Icon from "./Icon.astro";
import { ACCOUNTS, SITE } from "../lib/config";

// Opened in a browser, the feed itself is bare XML (it is for feed readers), so the button opens a reader instead
const FEED = `${SITE}feed.xml`;
---
<footer class="footer" data-footer-parallax>
  <div class="footer__inner">
    <div class="footer__top" data-footer-parallax-top>
      <div class="footer__form">
        <h2 class="footer__form-title">New on the shelf</h2>
        <p class="footer__text">A new book of the month on the first of every month. Follow it in a feed reader and it comes to you, with nothing to sign up for here.</p>
        <div class="footer__field footer__follow">
          <ButtonAlt href={`https://feedly.com/i/subscription/feed/${encodeURIComponent(FEED)}`} text="Follow on Feedly" colour="yellow" rel="noopener" />
          <p class="footer__follow-more">Or <a href={`https://www.inoreader.com/?add_feed=${encodeURIComponent(FEED)}`} rel="noopener">Inoreader</a>, or any other reader: <button class="footer__copy" type="button" data-copy-feed={FEED}>copy the feed address</button></p>
        </div>
      </div>
      <nav class="footer__nav" aria-label="Footer">
        <div class="footer__col">
          <h2 class="footer__heading">Library</h2>
          <ul><li><a href="books">All books</a></li><li><a href="genres">Genres</a></li><li><a href="./#new">Where to start</a></li></ul>
        </div>
        <div class="footer__col">
          <h2 class="footer__heading">Yours</h2>
          <ul><li><a href="reading">Your reading</a></li><li><a href="reading#notes">Your notes</a></li>{ACCOUNTS && <li><a href="account">Your account</a></li>}<li><a href="faq">Questions</a></li><li><a href="privacy">Privacy</a></li></ul>
        </div>
        <div class="footer__col">
          <h2 class="footer__heading">Elsewhere</h2>
          <ul><li><a href="https://github.com/Cl0ud-9/Book-Website">Source on GitHub</a></li><li><a href="https://github.com/Cl0ud-9">More from Cloud/9</a></li></ul>
        </div>
      </nav>
    </div>
    <p class="footer__wordmark" aria-hidden="true">Bookshelf</p>
    <div class="footer__bottom" data-footer-parallax-bottom>
      <p>© 2023–2026 The Bookshelf</p>
      <p>Designed and built by <a href="https://github.com/Cl0ud-9">Cloud/9</a></p>
      <a class="footer__top-link" href="#main" data-back-to-top>Back to top <Icon name="up" /></a>
    </div>
  </div>
</footer>
