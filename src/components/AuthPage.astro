---
// Sign in (login.html) and sign up (signup.html): what an account gives you, beside the form (the account page script).
// After a new account is made, the same card asks for a name and a mark. Without accounts, the address leads on to
// Your reading.
import AccountParts from "./AccountParts.astro";
import BgShapes from "./BgShapes.astro";
import ButtonAlt from "./ButtonAlt.astro";
import Icon from "./Icon.astro";
import Base from "../layouts/Base.astro";
import { ACCOUNTS, SITE } from "../lib/config";
import type { IconName } from "../lib/icons";
import { BLOB_A, BLOB_B } from "../lib/shapes";

interface Props {
  mode: "in" | "up";
}
const { mode } = Astro.props;
const up = mode === "up";
const page = up ? "signup.html" : "login.html";
const perks: [IconName, string][] = [["bookmark", "Your place in every book, on every device"], ["highlight", "Highlights and notes that follow you"],
  ["chart", "Your reading time and streak, all in one place"], ["user", "A reader page to share, if you want one"]];
const GOOGLE_G = '<svg class="acct__g" viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>'
  + '<path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>'
  + '<path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>'
  + '<path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>';
---
{ACCOUNTS ? (
<Base name={up ? "signup" : "login"} path={page} title={up ? "Create your account | The Bookshelf" : "Sign in | The Bookshelf"} description={up ? "A free account keeps your place, highlights, notes and reading time on every device." : "Sign in to the Bookshelf to pick up every book where you left it, on any device."} theme="soft-periwinkle" index={false}>
<section class={`auth is--${mode}`} data-auth-page data-auth-mode={mode} aria-labelledby="page-title">
  <div class="auth__art" data-intro-page>
    <BgShapes paths={[["is--violet-glow", BLOB_A], ["is--violet-glow", BLOB_B]]} class="auth__shapes" small />
    <p class="auth__eyebrow accent-note" data-hero-handwritten-text>{up ? "Free, forever" : "Welcome back"}</p>
    <h1 class="auth__title" id="page-title" data-hero-title>{up ? "Create your account" : "Sign in"}</h1>
    <p class="auth__lead" data-hero-paragraph>{up ? "One account for all your reading. It takes a minute, and you can delete it whenever you like." : "Pick up every book where you left it, on this device or any other."}</p>
    <ul class="auth__perks">{perks.map(([icon, text]) => <li><Icon name={icon} /><span>{text}</span></li>)}</ul>
    <div class="auth__covers" aria-hidden="true">{["pride-and-prejudice", "frankenstein", "the-great-gatsby"].map((s) => <img class="auth__cover" src={`image/covers/${s}-360.webp`} alt="" width="360" height="540" loading="lazy">)}</div>
  </div>
  <div class="auth__card" data-auth-card>
    <noscript><p class="mine__empty">Signing in needs JavaScript.</p></noscript>
    <p class="mine__empty" data-acct-off hidden>Accounts aren’t switched on for this copy of the Bookshelf. Everything still works on this device: see <a href="reading.html">Your reading</a>.</p>
    <p class="mine__empty acct__checking" data-acct-checking><Icon name="sync" />One moment…</p>
    <div class="auth__step" data-acct-out hidden>
      <h2 class="auth__card-title">{up ? "Start your shelf" : "Sign in to the Bookshelf"}</h2>
      <button type="button" class="acct__google" data-acct-google><Fragment set:html={GOOGLE_G} /><span>{up ? "Sign up with Google" : "Continue with Google"}</span></button>
      <p class="acct__or"><span>or with your email</span></p>
      <form class="acct__form" data-acct-email novalidate>
        <div class="acct__field"><label class="field"><input class="field__input" type="email" name="email" autocomplete="email" inputmode="email" required placeholder=" "><span class="field__label">Email</span></label></div>
        <div class="acct__field"><label class="field"><input class="field__input" type="password" name="password" autocomplete={up ? "new-password" : "current-password"} required minlength="8" placeholder=" " aria-describedby={up ? "acct-password-note" : undefined}><span class="field__label">Password</span>
          <button type="button" class="acct__show" data-acct-show aria-pressed="false" aria-label="Show the password"><Icon name="eye" /></button></label>{up && <span class="acct__note" id="acct-password-note">At least 8 characters</span>}</div>
        <button type="submit" class="acct__submit" data-acct-submit>{up ? "Create my account" : "Sign in"}<Icon name="arrow" /></button>
        {!up && <button type="button" class="acct__link" data-acct-forgot>Forgot your password?</button>}
      </form>
      <p class="acct__message" role="status" aria-live="polite" data-acct-message></p>
      <p class="auth__switch">{up ? <>Already have an account? <a href="login.html">Sign in</a></> : <>New here? <a href="signup.html">Create a free account</a></>}</p>
      <p class="acct__small">Your email is used only to sign you in. <a href="privacy.html">What an account keeps</a>.</p>
    </div>
    <AccountParts part="setup" class="auth__step" />
    <AccountParts part="merge" class="auth__step" />
    <div class="auth__step auth__done" data-auth-done hidden>
      <span data-auth-done-avatar></span>
      <h2 class="auth__card-title" data-auth-done-title>You’re all set</h2>
      <p class="mine__text" data-auth-done-text></p>
      <p class="mine__actions"><ButtonAlt href="reading.html" text="Your reading" colour="magenta" /><ButtonAlt href="books.html" text="Find a book" colour="black" /></p>
      <p class="acct__small"><a href="account.html">Your account</a>: your name and mark, your reader page, signing out.</p>
    </div>
  </div>
</section>
</Base>
) : (
<html lang="en">
<head>
<meta charset="UTF-8">
<title>The Bookshelf</title>
<meta name="robots" content="noindex">
<link rel="canonical" href={`${SITE}reading.html`}>
<meta http-equiv="refresh" content="0; url=reading.html">
</head>
<body><p><a href="reading.html">Continue to the Bookshelf</a></p></body>
</html>
)}
