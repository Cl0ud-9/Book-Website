---
import Icon from "./Icon.astro";

interface Props {
  question: string;
  answer: string;
  /** a link after the answer: [its words, its address] */
  link?: readonly [string, string];
}
const { question, answer, link } = Astro.props;
---
<details class="accordion" data-accordion>
  <summary class="accordion__summary" data-accordion-summary><span class="accordion__title">{question}</span><Icon name="plus" class="accordion__icon" /></summary>
  <div class="accordion__content" data-accordion-content><p>{answer}{link && <> <a href={link[1]}>{link[0]}</a></>}</p></div>
</details>
