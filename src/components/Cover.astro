---
// A book's cover, in the four sizes pipeline/library.py makes of it
import { BOOK, COVER } from "../lib/library";

interface Props {
  slug: string;
  sizes: string;
  lazy?: boolean;
  class?: string;
  priority?: boolean;
  /** the cover's description; "" when the cover only decorates (the title is beside it) */
  alt?: string;
  /** fetched only when a script asks (it copies data-src and data-srcset over): for covers that may never be shown */
  defer?: boolean;
}
const { slug, sizes, lazy = true, class: className, priority = false, alt, defer = false } = Astro.props;
const book = BOOK[slug];
if (!book) throw new Error(`no book ${slug}`);
// Only the big book at the top of a page goes to 1080. On a phone, a card's 80vw asked for it too, and scrolling through
// All books fetched 56 MB of covers where 720 (still twice the width a card is shown at) takes half that.
const srcset = (lazy ? [180, 360, 720] : [180, 360, 720, 1080]).map((w) => `image/covers/${slug}-${w}.webp ${w}w`).join(", ");
---
<img src={defer ? undefined : `image/covers/${slug}-360.webp`} srcset={defer ? undefined : srcset} data-src={defer ? `image/covers/${slug}-360.webp` : undefined}
  data-srcset={defer ? srcset : undefined} sizes={sizes} width={COVER.width} height={COVER.height}
  alt={alt ?? `${book.title} by ${book.author}, book cover`} class={className} data-age={book.age}
  loading={lazy ? "lazy" : undefined} decoding={lazy ? "async" : undefined} fetchpriority={priority ? "high" : undefined}>
