---
// The genres in big type; pointing at one (or pressing it on a phone) turns it handwritten and shows its covers
import Cover from "./Cover.astro";
import Icon from "./Icon.astro";
import { HOME_GROUPS, LIBRARY, groupBooks } from "../lib/library";

interface Props {
  /** each group's address */
  link: (group: string) => string;
  eyebrow?: string;
  more?: string;
  groups?: readonly string[];
  moreLink?: string;
}
const { link, eyebrow = "Choose from", more = "and more!", groups = HOME_GROUPS, moreLink = "genres.html" } = Astro.props;
// each group shows four covers around it, its most read books, repeating a small group's own
const coversFor = (g: string): string[] => {
  const mine = groupBooks(g).slice(0, 4).map((b) => b.slug);
  return [0, 1, 2, 3].map((i) => mine[i % mine.length]);
};
// "and more" is a genre too, pointed at like the others: its covers are the most read books the others do not show
const shown = new Set(groups.flatMap(coversFor));
const others = LIBRARY.filter((b) => !shown.has(b.slug)).slice(0, 4).map((b) => b.slug);
const entries = [...groups.map((g) => [g, link(g), ""] as const), [more, moreLink, " is--more"] as const];
---
<section class="genre" id="genres" aria-labelledby="genre-title" data-genre-interaction>
  <p class="genre__eyebrow" id="genre-title">{eyebrow}</p>
  <p class="genre__note accent-note" data-handwritten-text-inview>A classic for every kind of reader</p>
  <div class="genre__wrap">
    <ul class="genre__list" data-genre-interaction-list>
      {entries.map(([g, href, extra]) => (
        <li class={`genre__item${extra}`} data-genre-interaction-item><a class="genre__link" href={href}>
          <span class="genre__default">{g}</span><span class="genre__hover" aria-hidden="true">{g}</span></a></li>
      ))}
    </ul>
    <div class="genre__holding" aria-hidden="true" data-genre-interaction-scope>{[0, 1, 2, 3].map((h) => (
      <div class="genre__holder"><div class="genre__box" data-genre-interaction-box>{groups.map((g) => <Cover slug={coversFor(g)[h]} sizes="17em" alt="" class="genre__img" />)}<Cover slug={others[h]} sizes="17em" alt="" class="genre__img" /></div></div>
    ))}</div>
  </div>
  <span class="genre__emblem"><Icon name="logo" /></span>
</section>
