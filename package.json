{
  "name": "the-bookshelf",
  "version": "4.0.0-dev",
  "description": "The Bookshelf: a free library of classics to read in the browser or download, with page transitions and scroll animations.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:links": "node tests/links.mjs",
    "test:e2e": "node tests/run-e2e.mjs",
    "test:parity": "python tests/parity/compare.py",
    "assets:pull": "node pipeline/assets.mjs pull",
    "assets:push": "node pipeline/assets.mjs push",
    "emulators": "npx --yes firebase-tools@15.34.1 emulators:start --only auth,firestore --project demo-bookshelf"
  },
  "dependencies": {
    "@barba/core": "2.10.3",
    "@barba/prefetch": "2.2.0",
    "astro": "7.4.2",
    "epubjs": "0.3.93",
    "firebase": "12.19.0",
    "gsap": "3.15.0",
    "jszip": "3.10.1",
    "lenis": "1.3.27",
    "smooothy": "0.0.35"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "@firebase/util": false,
    "core-js": false,
    "es5-ext": false,
    "protobufjs": false
  }
}
